#!/bin/bash
# Mechanically blocks committing P4-designated files unless pipeline/gate_check.py
# has stamped .pipeline_gate_state.json with the EXACT current HEAD commit hash.
#
# Why this exists: three separate cycles satisfied the P3.5 "does the pipeline
# actually produce a playable game" gate via prose-based self-assessment, and
# each found a different way to be technically defensible while substantively
# wrong (a mid-pipeline artifact, and twice, evidence that was real but stale
# relative to the code being gated - once missed by a human-built LLM judge
# checking the same evidence). This hook removes the judgment call: P0-P3 bug
# fixes commit freely regardless of this file's contents, but a P4 file cannot
# land unless the gate was freshly verified against the exact commit it's
# landing on top of. Any other commit moves HEAD and silently invalidates an
# old stamp - that is the intended behavior, not a bug to work around.

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
STATE_FILE="$REPO_ROOT/.pipeline_gate_state.json"

# Paths considered P4 work. Extend this list as new P4 items land.
P4_PATTERN='^pipeline/vendor/(art|ui)\.js$'

staged_files=$(git diff --cached --name-only --diff-filter=ACM)

# Mechanically blocks any commit that drastically shrinks HERMES_CRON_LOG.md -
# the autonomous cron agent's own durable memory of its prior cycles. This has
# happened for real, three separate times, from the same root cause: a cycle
# "prepends" a new entry from its own (possibly truncated) memory of the file
# instead of re-reading it fresh first, silently dropping everything it didn't
# remember. An audit caught and restored it each time - after the fact, once
# it had already landed. This blocks it before it lands instead.
LOG_FILE="HERMES_CRON_LOG.md"
if echo "$staged_files" | grep -qx "$LOG_FILE"; then
    if git cat-file -e "HEAD:$LOG_FILE" 2>/dev/null; then
        old_lines=$(git show "HEAD:$LOG_FILE" | wc -l)
        new_lines=$(git show ":$LOG_FILE" | wc -l)
        if [ "$old_lines" -gt 20 ]; then
            threshold=$((old_lines * 70 / 100))
            if [ "$new_lines" -lt "$threshold" ] && [ -z "$ALLOW_LOG_SHRINK" ]; then
                echo "BLOCKED: $LOG_FILE would shrink from $old_lines to $new_lines lines"
                echo "(more than 30% smaller). This exact failure mode has happened three"
                echo "times before: a cycle 'prepending' from its own truncated memory of"
                echo "the file instead of re-reading it fresh, silently dropping history."
                echo "Re-read the FULL current file and prepend your new entry to ALL of"
                echo "it - never regenerate the file from memory. If this shrink is"
                echo "genuinely intentional (e.g. deliberate archiving), retry with"
                echo "ALLOW_LOG_SHRINK=1 git commit ..."
                exit 1
            fi
        fi
    fi

    # Mechanically blocks a new top entry whose date header has drifted from
    # the real system clock. This has happened for real, ten separate times
    # (see LESSONS_LEARNED.md) - every instance traced back to a cycle
    # computing or guessing "today's date" instead of actually running `date`.
    # A prompt instruction telling it to run `date -u` first was tried and
    # did not hold (an independent audit caught an 11th instance land AFTER
    # that instruction was added) - a written request a free-tier model can
    # silently skip is not a gate, so this checks the actual clock instead.
    if [ -z "$ALLOW_LOG_TIMESTAMP_DRIFT" ]; then
        top_line=$(git show ":$LOG_FILE" | head -1)
        entry_date=$(echo "$top_line" | grep -oE '^[0-9]{4}-[0-9]{2}-[0-9]{2}' || true)
        if [ -n "$entry_date" ]; then
            real_date=$(date -u +%Y-%m-%d)
            entry_epoch=$(date -u -d "$entry_date" +%s 2>/dev/null || echo "")
            real_epoch=$(date -u -d "$real_date" +%s)
            if [ -n "$entry_epoch" ]; then
                diff=$((entry_epoch - real_epoch))
                abs_diff=${diff#-}
                if [ "$abs_diff" -gt 86400 ]; then
                    days=$((abs_diff / 86400))
                    echo "BLOCKED: $LOG_FILE's new top entry is dated $entry_date, but the"
                    echo "real system date (per 'date -u' right now) is $real_date -"
                    echo "that's $days day(s) off. Run 'date -u +\"%Y-%m-%d %H:%M UTC\"'"
                    echo "yourself and use THAT exact output as the entry header - do not"
                    echo "compute, estimate, or carry a date forward from the previous entry."
                    echo "If this is genuinely intentional, retry with"
                    echo "ALLOW_LOG_TIMESTAMP_DRIFT=1 git commit ..."
                    exit 1
                fi
            fi
        fi
    fi
fi

p4_touched=$(echo "$staged_files" | grep -E "$P4_PATTERN" || true)

if [ -z "$p4_touched" ]; then
    # Nothing P4-related in this commit - let it through unconditionally.
    exit 0
fi

echo "This commit touches P4-designated file(s):"
echo "$p4_touched" | sed 's/^/  /'
echo ""

if [ ! -f "$STATE_FILE" ]; then
    echo "BLOCKED: no $STATE_FILE found. Run 'python pipeline/gate_check.py' and get a"
    echo "genuine PASS before committing P4 work. See CRITIQUE_REPORT.md's P3.5 section."
    exit 1
fi

current_head=$(git rev-parse HEAD)
stamped_head=$(python3 -c "import json; print(json.load(open('$STATE_FILE')).get('commit_hash',''))" 2>/dev/null || echo "")

if [ "$stamped_head" != "$current_head" ]; then
    echo "BLOCKED: $STATE_FILE is stamped for commit ${stamped_head:0:12}, but HEAD is"
    echo "now ${current_head:0:12} - something else was committed since the gate was"
    echo "last verified, which invalidates it. Re-run 'python pipeline/gate_check.py'"
    echo "on the current HEAD and get a fresh PASS before committing P4 work."
    exit 1
fi

echo "Gate stamp matches current HEAD (${current_head:0:12}) - P4 commit allowed."
exit 0
