ANTHROPIC_API_KEY=your_key_here
# Only needed if LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_key_here

# "anthropic" (direct Anthropic API, uses ANTHROPIC_API_KEY) or "openrouter"
LLM_PROVIDER=anthropic

# Optional overrides
# GENERATION_MODEL_ANTHROPIC=claude-sonnet-4-5-20250929
# REVIEW_MODEL_ANTHROPIC=claude-haiku-4-5-20251001
# GENERATION_MODEL_OPENROUTER=anthropic/claude-sonnet-4
# REVIEW_MODEL_OPENROUTER=anthropic/claude-3-haiku
# MAX_DESIGN_ATTEMPTS=3
# MAX_CODE_ATTEMPTS=2
# PLACEMENT_TYPE: placement type for MRAID (e.g., 'interstitial', 'rewarded'). Defaults to 'interstitial'.

# Optional: Agentic Playability Check (requires `claude` CLI)
# Install: npm install -g @anthropic-ai/claude-code
# If claude is not in PATH, the playability check is SKIPPED (not failed).
# CLAUDE_CLI_PATH=/usr/local/bin/claude
